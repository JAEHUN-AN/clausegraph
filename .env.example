# 국가법령정보센터 Open API (무료 신청)
LAW_API_OC=

# Neo4j
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=clausegraph

# Postgres + pgvector
POSTGRES_PASSWORD=clausegraph
PG_DSN=postgresql://clausegraph:clausegraph@localhost:5434/clausegraph

# 로컬 LLM (llama.cpp OpenAI 호환 엔드포인트) — 폐쇄망 전제
LLM_BASE_URL=http://localhost:8090/v1
LLM_MODEL=
LLM_TIMEOUT_SEC=120

# 모델 급 비교용 — 측정할 때만 쓴다. 심사 경로는 위의 로컬만 본다(notes/031).
# 둘 다 무료 티어로 충분하다. 비워 두면 그 단은 측정에서 빠진다.
#   Groq   https://console.groq.com/keys      (오픈웨이트 70B급)
#   Gemini https://aistudio.google.com/apikey (프론티어)
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
